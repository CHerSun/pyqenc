%% Audio processing model: select -> chains, and each (track x chain) -> one output.
%% One chain applied to N selected tracks produces exactly N outputs
%% (deterministic N-in -> N-out); there is no combinatorial fan-out.
%% See docs/audio-processing.md for the full guide.
flowchart LR
    %% ---- inputs -------------------------------------------------------
    subgraph IN["Extracted audio tracks"]
        TA["track A<br/>lang=rus ch=5.1"]
        TB["track B<br/>lang=eng ch=7.1"]
        TC["track C<br/>lang=eng ch=2.0"]
    end

    %% ---- select -------------------------------------------------------
    SEL{{"select<br/>(empty = all tracks;<br/>for / exclude / prefer,<br/>additive + dedup)"}}
    TA --> SEL
    TB --> SEL
    TC --> SEL
    SEL -->|working track set| WS["selected tracks"]

    %% ---- palette + chains --------------------------------------------
    subgraph PAL["filters (named palette)"]
        F1["peaknorm"]
        F2["down_lfe"]
        F3["dynaudnorm"]
        F4["down_std"]
        F5["aac (encode)"]
    end

    subgraph CH["chains (ordered recipes)"]
        C1["normal:<br/>[peaknorm] -> FLAC"]
        C2["night:<br/>[down_lfe, dynaudnorm] -> FLAC"]
        C3["aac:<br/>[down_std, peaknorm, aac] -> m4a"]
    end

    F1 --> C1
    F2 --> C2
    F3 --> C2
    F4 --> C3
    F1 --> C3
    F5 --> C3

    %% ---- track x chain -> one output each ----------------------------
    WS --> C1
    WS --> C2
    WS --> C3

    C1 --> O1["stem chain=normal.flac<br/>(one per selected track)"]
    C2 --> O2["stem chain=night.flac<br/>(one per selected track)"]
    C3 --> O3["stem chain=aac.m4a<br/>(one per selected track)"]

    classDef out fill:#2d6a4f,color:#fff
    class O1,O2,O3 out
